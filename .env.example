# ===== 必填 =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bendy_shadowsend
CHAT_ENCRYPTION_KEY=change-me-to-at-least-32-characters

# ===== 应用（可选） =====
APP_AUTH=bendywork

# ===== 上传通道（可选，通常无需修改） =====
# SANG_UPLOAD_URL=https://file.sang.pub/api/upload
# UPLOAD_SESSION_SECRET=
# UPLOAD_ALLOWED_ORIGINS=

# ===== 旧存储配置（仅存量读取，不再参与新上传） =====
# 新部署留空即可；已有部署保留原值以读取历史附件。
# up-12（存量清零后）会移除这些配置。
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# DUFS_BASE_URL=
# DUFS_PUBLIC_BASE_URL=
# DUFS_PATH_PREFIX=
# DUFS_AUTH=
# OSS_PREVIEW_RPC_URL=
# OSS_PREVIEW_BUCKET_NAME=
# OSS_PREVIEW_COOKIE=
